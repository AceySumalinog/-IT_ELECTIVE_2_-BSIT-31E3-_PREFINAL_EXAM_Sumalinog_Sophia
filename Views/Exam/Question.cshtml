@{
    ViewData["Title"] = "Quest 15";
}

<link rel="stylesheet" href="~/css/exam.css" />

<div class="system-page">

    <div class="system-header">
        <div class="system-label">SYSTEM WINDOW</div>
        <div class="system-line"></div>
        <h1>QUEST 15</h1>
        <p class="subtitle">MVC EXAM HUNTER</p>
    </div>

    <div class="mission-window">

        <div class="window-header">
            <span>⚔ QUEST INFORMATION</span>
            <span>QUEST 15 / 20</span>
        </div>

        <div class="player-content">

            <div class="quest-number">
                QUESTION 15
            </div>

            <div class="mission-title">
                MULTIPLE CHOICE
            </div>

            <div class="mission-text">
                A school requires every student to have a unique
                Student Number. Which rule best represents this requirement?
            </div>

            <div class="system-message">

                <div class="message-title">
                    SELECT YOUR ANSWER
                </div>

                <div class="message-content">

                    <p><strong>A.</strong> Student Number should always be nullable</p>

                    <p><strong>B.</strong> Student Number should be unique</p>

                    <p><strong>C.</strong> Student Number should always be the same</p>

                    <p><strong>D.</strong> Student Number should contain only spaces</p>

                </div>

            </div>

            <div class="mission-reward">
                ⭐ CORRECT ANSWER: B
            </div>

        </div>

    </div>

    <div class="start-section">
        <a asp-controller="Exam"
           asp-action="Index"
           class="start-button">
            ← RETURN TO STATUS
        </a>
    </div>

    <div class="system-footer">
        PLAYER: SUMALINOG SOPHIA |
        CLASS: BSIT31E3 |
        SYSTEM: MVC EXAM HUNTER
    </div>

</div>
