@{
    ViewData["Title"] = "Quest 07";
}

<link rel="stylesheet" href="~/css/exam.css" />

<div class="system-page">

    <div class="system-header">
        <div class="system-label">SYSTEM WINDOW</div>
        <div class="system-line"></div>
        <h1>QUEST 07</h1>
        <p class="subtitle">MVC EXAM HUNTER</p>
    </div>

    <div class="mission-window">

        <div class="window-header">
            <span>⚔ QUEST INFORMATION</span>
            <span>QUEST 07 / 20</span>
        </div>

        <div class="player-content">

            <div class="quest-number">
                QUESTION 07
            </div>

            <div class="mission-title">
                MULTIPLE CHOICE
            </div>

            <div class="mission-text">
                A Student belongs to exactly one Section, while a Section
                can contain many students. What type of relationship is this?
            </div>

            <div class="system-message">

                <div class="message-title">
                    SELECT YOUR ANSWER
                </div>

                <div class="message-content">

                    <p><strong>A.</strong> One-to-One</p>

                    <p><strong>B.</strong> One-to-Many</p>

                    <p><strong>C.</strong> Many-to-Many</p>

                    <p><strong>D.</strong> Many-to-One only</p>

                </div>

            </div>

            <div class="mission-reward">
                ⭐ CORRECT ANSWER: B
            </div>

        </div>

    </div>

    <div class="start-section">
        <a asp-controller="Exam"
           asp-action="Index"
           class="start-button">
            ← RETURN TO STATUS
        </a>
    </div>

    <div class="system-footer">
        PLAYER: SUMALINOG SOPHIA |
        CLASS: BSIT31E3 |
        SYSTEM: MVC EXAM HUNTER
    </div>

</div>
