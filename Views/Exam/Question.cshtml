@model IT_ELECTIVE_2_BSIT31E3_PREFINAL_EXAM_Sumalinog_Sophia.Controllers.ExamQuestion

@{
    ViewData["Title"] = $"Quest {Model.Number:00}";
}

<link rel="stylesheet" href="~/css/exam.css" />

<div class="system-page">

    <div class="system-header">

        <div class="system-label">
            SYSTEM WINDOW
        </div>

        <div class="system-line"></div>

        <h1>
            QUEST @Model.Number.ToString("00")
        </h1>

        <p class="subtitle">
            MVC EXAM HUNTER
        </p>

    </div>


    <div class="mission-window">

        <div class="window-header">

            <span>
                ⚔ QUEST INFORMATION
            </span>

            <span>
                QUEST @Model.Number / 20
            </span>

        </div>


        <div class="player-content">

            <div class="quest-number">
                QUESTION @Model.Number
            </div>


            <div class="mission-title">
                MULTIPLE CHOICE
            </div>


            <div class="mission-text">
                @Model.Question
            </div>


            <!-- ANSWERS -->

            <div class="system-message">

                <div class="message-title">
                    SELECT YOUR ANSWER
                </div>


                <div class="message-content">

                    <!-- ANSWER A -->

                    <label class="answer-option
                        @(Model.Answer == "A" ? "correct-answer" : "")">

                        <input type="radio"
                               name="answer"
                               value="A"
                        @(Model.Answer == "A" ? "checked" : "")
                               disabled />

                        <span>
                            <strong>A.</strong>
                            @Model.A
                        </span>

                    </label>


                    <!-- ANSWER B -->

                    <label class="answer-option
                        @(Model.Answer == "B" ? "correct-answer" : "")">

                        <input type="radio"
                               name="answer"
                               value="B"
                        @(Model.Answer == "B" ? "checked" : "")
                               disabled />

                        <span>
                            <strong>B.</strong>
                            @Model.B
                        </span>

                    </label>


                    <!-- ANSWER C -->

                    <label class="answer-option
                        @(Model.Answer == "C" ? "correct-answer" : "")">

                        <input type="radio"
                               name="answer"
                               value="C"
                        @(Model.Answer == "C" ? "checked" : "")
                               disabled />

                        <span>
                            <strong>C.</strong>
                            @Model.C
                        </span>

                    </label>


                    <!-- ANSWER D -->

                    <label class="answer-option
                        @(Model.Answer == "D" ? "correct-answer" : "")">

                        <input type="radio"
                               name="answer"
                               value="D"
                        @(Model.Answer == "D" ? "checked" : "")
                               disabled />

                        <span>
                            <strong>D.</strong>
                            @Model.D
                        </span>

                    </label>

                </div>

            </div>


            <!-- RESULT -->

            <div class="mission-reward correct-result">

                ⭐ ANSWER VERIFIED

                <br />

                <span>
                    The Player has selected the correct answer.
                </span>

            </div>


            <!-- NEXT BUTTON -->

            <div class="start-section">

                @if (Model.Number < 20)
                {
                    <a href="/Exam/Question/@(Model.Number + 1)"
                       class="start-button">

                        NEXT QUEST →

                    </a>
                }
                else
                {
                    <a href="/Exam"
                       class="start-button">

                        🏆 RETURN TO PLAYER STATUS

                    </a>
                }

            </div>

        </div>

    </div>


    <div class="system-footer">

        PLAYER: SUMALINOG SOPHIA |

        CLASS: BSIT31E3 |

        SYSTEM: MVC EXAM HUNTER

    </div>

</div>
